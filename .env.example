# ═══════════════════════════════════════════════════════════════════
#  FoodDash — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it is in .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Spring Profile ───────────────────────────────────────────────
# local  → uses application-local.properties (verbose logging, local MySQL)
# prod   → uses application-prod.properties  (RDS, minimal logging)
SPRING_PROFILES_ACTIVE=local

# ── Database ─────────────────────────────────────────────────────
# Local:  DB_HOST=localhost
# EC2:    DB_HOST=<your-rds-endpoint>.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_delivery
DB_USERNAME=root
DB_PASSWORD=root

# ── JWT ──────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ── AWS Credentials ──────────────────────────────────────────────
# LOCAL:  Set your IAM user Access Key + Secret below
# EC2:    Leave blank — the app will use the attached IAM Role automatically
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── AWS SNS ───────────────────────────────────────────────────────
# Step 1: Start the app, then call POST /api/sns/setup?email=you@example.com
# Step 2: Confirm the subscription email AWS sends you
# Step 3: Copy the topicArn from the response and paste it below
# Step 4: Restart the app — SNS notifications will now fire on every order update
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:food-delivery-notifications
SNS_EMAIL=your-email@example.com

# ── Server ───────────────────────────────────────────────────────
PORT=8080
