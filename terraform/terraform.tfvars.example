# Copy this file to terraform.tfvars and fill in the sensitive values.
# Never commit terraform.tfvars to source control.

aws_region         = "us-east-1"
project            = "food-delivery"
environment        = "dev"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

app_port           = 8080
ec2_instance_type  = "t3.small"
ec2_key_name       = "food-delivery-key"
# ec2_ami_id       = "ami-0c02fb55956c7d316"   # Amazon Linux 2023 us-east-1

db_name            = "food_delivery"
db_username        = "admin"
db_instance_class  = "db.t3.micro"

# ── Sensitive — set via env vars or CI secrets, not here ─────────────────────
# db_password        = "CHANGE_ME"
# notification_email = "your-email@example.com"
# jwt_secret         = "404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970"
